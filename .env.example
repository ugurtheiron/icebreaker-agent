# Copy this file to .env and fill in the values. Never commit .env.

# ice_breaker.py and agents/linkedin_lookup_agent.py (OpenAI chat models)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# agents/linkedin_lookup_agent.py (Tavily web search)
TAVILY_API_KEY=YOUR_TAVILY_API_KEY

# ice_breaker.py without --mock (Proxycurl; the service was shut down in July 2025)
PROXYCURL_API_KEY=YOUR_PROXYCURL_API_KEY

# tools/tools.py (Firecrawl product-page extraction)
FIRECRAWL_API_KEY=YOUR_FIRECRAWL_API_KEY

# Optional: LangSmith tracing (picked up automatically by LangChain)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=YOUR_LANGSMITH_API_KEY
# LANGCHAIN_PROJECT=icebreaker-agent
